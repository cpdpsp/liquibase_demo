<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create common schema" author="sp">
        <sql>CREATE SCHEMA IF NOT EXISTS common</sql>
    </changeSet>

    <changeSet id="create table" author="sp">
        <preConditions onFail="CONTINUE" onFailMessage="Table student already exists. It's creation will be skipped.">
            <not>
                <tableExists schemaName="common" tableName="student"/>
            </not>
        </preConditions>
        <createTable tableName="student" schemaName="common">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
           <column name="name" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
